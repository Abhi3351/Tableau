    <worksheet name='Task 5'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Task 5: </run>
            <run fontcolor='#000000' fontname='Benton Sans Book' italic='true'>Business Growth Evaluation Business Need: Senior management wants to assess whether the business is growing consistently. </run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Task:</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> Visualize cumulative Sales growth over time to evaluate overall performance.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Retail_dataset' name='federated.004l7we00mpwme1ff7rdj0sxziww' />
          </datasources>
          <datasource-dependencies datasource='federated.004l7we00mpwme1ff7rdj0sxziww'>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column caption='Order Date' datatype='date' name='[Order_Date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Region]' role='dimension' type='nominal' />
            <column datatype='real' name='[Sales]' role='measure' type='quantitative' />
            <column-instance column='[Sales]' derivation='Sum' name='[cum:sum:Sales:qk]' pivot='key' type='quantitative'>
