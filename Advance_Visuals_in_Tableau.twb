      <table>
        <view>
          <datasources>
            <datasource caption='Healthcare_Advanced_Tableau_Assignment_Dataset_v2' name='federated.0jsj8mi1vie2441ads6o106u4dwl' />
          </datasources>
          <datasource-dependencies datasource='federated.0jsj8mi1vie2441ads6o106u4dwl'>
