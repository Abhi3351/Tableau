  <worksheets>
    <worksheet name='Q1'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Question 1 :</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> What is a Calculated Field and why is it important in business dashboards?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources />
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
          </pane>
        </panes>
        <rows />
        <cols />
        <annotations>
          <annotation class='area' id='0' text-pinx='0.5' text-piny='0.5' text-width-delta='-18'>
            <formatted-text>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>A </run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Calculated Field</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'> in Tableau (and other BI tools) is a </run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>user‑defined field created using formulas</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>. Instead of relying only on raw data columns, you can write expressions (similar to Excel formulas) to generate new values.</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>For example:</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Profit Margin = </run>
              <run fontalignment='0' fontcolor='#000000' fontname='Courier New' fontsize='15'>SUM([Profit]) / SUM([Sales])</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Categorization = </run>
              <run fontalignment='0' fontcolor='#000000' fontname='Courier New' fontsize='15'>IF [Sales] &gt; 1000 THEN &quot;High&quot; ELSE &quot;Low&quot; END</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>This allows you to </run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>extend your dataset</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'> with custom logic that isn’t directly available in the source data.</run>
            </formatted-text>
            <top-left>
              <visual-coordinate class='axis'>
                <x-coord cell-offset='0'>
                  <node-reference />
                </x-coord>
                <y-coord cell-offset='0'>
                  <node-reference />
                </y-coord>
                <page-reference />
              </visual-coordinate>
            </top-left>
            <bottom-right>
              <visual-coordinate class='axis'>
                <x-coord cell-offset='0.998638'>
                  <node-reference />
                </x-coord>
                <y-coord cell-offset='0.247619'>
                  <node-reference />
                </y-coord>
                <page-reference />
              </visual-coordinate>
            </bottom-right>
            <text x='0.5' y='0.5' />
          </annotation>
          <annotation class='area' id='1' text-pinx='0.5' text-piny='0.5' text-width-delta='-18'>
            <formatted-text>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Why is it Important in Business Dashboards?</run>
            </formatted-text>
            <top-left>
              <visual-coordinate class='axis'>
                <x-coord cell-offset='0'>
                  <node-reference />
                </x-coord>
                <y-coord cell-offset='0.24898'>
                  <node-reference />
                </y-coord>
                <page-reference />
              </visual-coordinate>
            </top-left>
            <bottom-right>
              <visual-coordinate class='axis'>
                <x-coord cell-offset='0.998638'>
                  <node-reference />
                </x-coord>
                <y-coord cell-offset='0.310204'>
                  <node-reference />
                </y-coord>
                <page-reference />
              </visual-coordinate>
            </bottom-right>
            <text x='0.5' y='0.5' />
          </annotation>
          <annotation class='area' id='2' text-pinx='0.5' text-piny='0.5' text-width-delta='-18'>
            <formatted-text>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Calculated Fields are crucial because they:</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Enable Custom KPIs</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Businesses often need metrics like </run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15' italic='true'>Customer Lifetime Value</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>, </run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15' italic='true'>Conversion Rate</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>, or </run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15' italic='true'>Profit Margin</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'> that aren’t raw columns in the database.</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Calculated Fields let you define these KPIs directly in Tableau.</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Support Dynamic Analysis</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>They adapt to filters, slicers, and drill‑downs, making dashboards interactive and context‑aware.</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Example: A calculated </run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15' italic='true'>Growth Rate</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'> measure will automatically update when you filter by year or region.</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Simplify Complex Data</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Instead of cluttering dashboards with multiple raw fields, you can combine logic into one calculated field.</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>This makes dashboards cleaner and easier for business users to interpret.</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Improve Decision‑Making</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Executives don’t want raw numbers—they want insights.</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Calculated Fields transform raw data into actionable insights, helping leaders spot trends, risks, and opportunities.</run>
            </formatted-text>
            <top-left>
              <visual-coordinate class='axis'>
                <x-coord cell-offset='0'>
                  <node-reference />
                </x-coord>
                <y-coord cell-offset='0.310204'>
                  <node-reference />
                </y-coord>
                <page-reference />
              </visual-coordinate>
            </top-left>
            <bottom-right>
              <visual-coordinate class='axis'>
                <x-coord cell-offset='0.998638'>
                  <node-reference />
                </x-coord>
                <y-coord cell-offset='0.787755'>
                  <node-reference />
                </y-coord>
                <page-reference />
              </visual-coordinate>
            </bottom-right>
            <text x='0.5' y='0.5' />
          </annotation>
        </annotations>
      </table>
      <simple-id uuid='{F6352AE6-532A-476E-90D7-5928978254A9}' />
    </worksheet>
    <worksheet name='Q2'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Question 2 :</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> Why can’t parameters change visuals directly in Tableau?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources />
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
          </pane>
        </panes>
        <rows />
        <cols />
        <annotations>
          <annotation class='area' id='0' text-pinx='0.5' text-piny='0.5' text-width-delta='-18'>
            <formatted-text>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Parameters in Tableau are </run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>independent variables</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>—they are not tied to the data source or visualization by default. Think of them as </run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>placeholders for a single value</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'> (like a slider, dropdown, or input box).</run>
            </formatted-text>
            <top-left>
              <visual-coordinate class='axis'>
                <x-coord cell-offset='0'>
                  <node-reference />
                </x-coord>
                <y-coord cell-offset='0'>
                  <node-reference />
                </y-coord>
                <page-reference />
              </visual-coordinate>
            </top-left>
            <bottom-right>
              <visual-coordinate class='axis'>
                <x-coord cell-offset='0.998638'>
                  <node-reference />
                </x-coord>
                <y-coord cell-offset='0.12517'>
                  <node-reference />
                </y-coord>
                <page-reference />
              </visual-coordinate>
            </bottom-right>
            <text x='0.5' y='0.5' />
          </annotation>
          <annotation class='area' id='1' text-pinx='0.5' text-piny='0.5' text-width-delta='-18'>
            <formatted-text>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Why They Don’t Change Visuals Automatically?
</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>1. No Direct Link to Data</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Parameters are not connected to the underlying dataset.</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Unlike filters, they don’t query or restrict rows in the data source.
</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>2. Require Calculated Fields or Logic</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>A parameter only becomes useful when you reference it inside a </run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>calculated field, filter, or reference line</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>.</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Without this connection, changing the parameter value has no effect on the visualization.
</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>3. Design Philosophy</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Tableau separates </run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>user input (parameters)</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'> from </run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>data manipulation (filters/calculations)</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>.</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>This gives flexibility: the same parameter can drive multiple calculations, thresholds, or scenarios, instead of being locked to one chart.</run>
            </formatted-text>
            <top-left>
              <visual-coordinate class='axis'>
                <x-coord cell-offset='0'>
                  <node-reference />
                </x-coord>
                <y-coord cell-offset='0.121088'>
                  <node-reference />
                </y-coord>
                <page-reference />
              </visual-coordinate>
            </top-left>
            <bottom-right>
              <visual-coordinate class='axis'>
                <x-coord cell-offset='0.998638'>
                  <node-reference />
                </x-coord>
                <y-coord cell-offset='0.580952'>
                  <node-reference />
                </y-coord>
                <page-reference />
              </visual-coordinate>
            </bottom-right>
            <text x='0.5' y='0.5' />
          </annotation>
        </annotations>
      </table>
      <simple-id uuid='{A8C938C3-DEFD-4603-969F-6D846EFD3A5B}' />
    </worksheet>
    <worksheet name='Q3'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Question 3 :</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> When should EXCLUDE LOD be used?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources />
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
          </pane>
        </panes>
        <rows />
        <cols />
        <annotations>
          <annotation class='area' id='0' text-pinx='0.5' text-piny='0.5' text-width-delta='-18'>
            <formatted-text>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>The </run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>EXCLUDE Level of Detail (LOD) expression</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'> is used when you want to </run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>remove certain dimensions from a calculation</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>, even if those dimensions are present in the view.</run>
            </formatted-text>
            <top-left>
              <visual-coordinate class='axis'>
                <x-coord cell-offset='0'>
                  <node-reference />
                </x-coord>
                <y-coord cell-offset='0.00544218'>
                  <node-reference />
                </y-coord>
                <page-reference />
              </visual-coordinate>
            </top-left>
            <bottom-right>
              <visual-coordinate class='axis'>
                <x-coord cell-offset='0.999319'>
                  <node-reference />
                </x-coord>
                <y-coord cell-offset='0.142857'>
                  <node-reference />
                </y-coord>
                <page-reference />
              </visual-coordinate>
            </bottom-right>
            <text x='0.5' y='0.5' />
          </annotation>
          <annotation class='area' id='1' text-pinx='0.5' text-piny='0.5' text-width-delta='-18'>
            <formatted-text>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Situations Where EXCLUDE is Useful</run>
              <run fontalignment='0'>Æ&#10;&#10;</run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>1. Removing Granularity for Higher-Level Aggregation</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Example: You have a chart showing </run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15' italic='true'>Sales by City</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>, but you want to calculate </run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15' italic='true'>Sales at the Region level</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'> while still displaying cities.</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Formula:</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>tableau</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>{ EXCLUDE [City] : SUM([Sales]) }</run>
              <run fontalignment='0'>Æ&#10;&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>This ignores city-level detail and computes sales at the region level.
</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>2. Avoiding Double Counting</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>When multiple dimensions in the view cause duplication, EXCLUDE helps simplify the calculation by removing one of them.</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Example: Calculating </run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15' italic='true'>average sales per region</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'> while the view shows both </run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15' italic='true'>Region</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'> and </run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15' italic='true'>Category</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>.&#10;</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>3. Comparisons Between Different Levels</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Useful when you want to compare a detailed metric (e.g., city sales) against a higher-level metric (e.g., region sales).</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>EXCLUDE lets you compute the higher-level metric without leaving the detailed breakdown in the visualization.
</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>4. Cleaner Dashboards</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Instead of creating separate worksheets for different levels of aggregation, EXCLUDE allows you to handle multiple levels of detail in one visualization.</run>
            </formatted-text>
            <top-left>
              <visual-coordinate class='axis'>
                <x-coord cell-offset='0'>
                  <node-reference />
                </x-coord>
                <y-coord cell-offset='0.145578'>
                  <node-reference />
                </y-coord>
                <page-reference />
              </visual-coordinate>
            </top-left>
            <bottom-right>
              <visual-coordinate class='axis'>
                <x-coord cell-offset='0.998638'>
                  <node-reference />
                </x-coord>
                <y-coord cell-offset='0.843537'>
                  <node-reference />
                </y-coord>
                <page-reference />
              </visual-coordinate>
            </bottom-right>
            <text x='0.5' y='0.5' />
          </annotation>
        </annotations>
      </table>
      <simple-id uuid='{CD425EED-B7C6-439C-A4EE-974A2F5FBFA4}' />
    </worksheet>
    <worksheet name='Q4'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='18'>Question 4 :</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='18'> Difference between FIXED and INCLUDE LOD expressions?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources />
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
          </pane>
        </panes>
        <rows />
        <cols />
        <annotations>
          <annotation class='area' id='0' text-pinx='0.5' text-piny='0.5' text-width-delta='-18'>
            <formatted-text>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Both are </run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Level of Detail (LOD) expressions</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>, but they serve different purposes in controlling calculation granularity.</run>
            </formatted-text>
            <top-left>
              <visual-coordinate class='axis'>
                <x-coord cell-offset='0'>
                  <node-reference />
                </x-coord>
                <y-coord cell-offset='0'>
                  <node-reference />
                </y-coord>
                <page-reference />
              </visual-coordinate>
            </top-left>
            <bottom-right>
              <visual-coordinate class='axis'>
                <x-coord cell-offset='0.998638'>
                  <node-reference />
                </x-coord>
                <y-coord cell-offset='0.0870748'>
                  <node-reference />
                </y-coord>
                <page-reference />
              </visual-coordinate>
            </bottom-right>
            <text x='0.5' y='0.5' />
          </annotation>
          <annotation class='area' id='1' text-pinx='0.5' text-piny='0.5' text-width-delta='-18'>
            <formatted-text>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>1. FIXED LOD</run>
              <run fontalignment='0'>Æ&#10;&#10;</run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>&gt;&gt; Definition</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>: Calculates values at a specific dimension level, </run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>ignoring whatever dimensions are in the view</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>.</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>&gt;&gt; Behavior</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>: Locks the calculation to the level you specify.</run>
              <run fontalignment='0'>Æ&#10;&#10;</run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>&gt;&gt; Example</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>:</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>tableau</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>{ FIXED [Region] : SUM([Sales]) }</run>
              <run fontalignment='0'>Æ&#10;&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>→ Always computes sales at the </run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Region level</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>, even if the view shows City or Category.</run>
              <run fontalignment='0'>Æ&#10;&#10;</run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>&gt;&gt; Use Case</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>:</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>When you need a </run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>consistent aggregation</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'> regardless of filters or visualization detail.</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Example: Calculating </run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15' italic='true'>total sales per region</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'> while the dashboard shows breakdowns by city.</run>
              <run fontalignment='0'>Æ&#10;&#10;</run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>2. INCLUDE LOD</run>
              <run fontalignment='0'>Æ&#10;&#10;</run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>&gt;&gt; Definition</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>: Adds extra dimensions into the calculation, </run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>even if those dimensions are not in the view</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>.</run>
              <run fontalignment='0'>Æ&#10;&#10;</run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>&gt;&gt; Behavior</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>: Expands granularity to include more detail.</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Example</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>:</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>tableau</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>{ INCLUDE [Customer] : AVG([Sales]) }</run>
              <run fontalignment='0'>Æ&#10;&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Computes average sales at the </run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Customer level</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>, even if the view only shows Region.</run>
              <run fontalignment='0'>Æ&#10;&#10;</run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>&gt;&gt; Use Case</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>:</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>When you want to </run>
              <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>drill down into finer detail</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'> for calculations while keeping the visualization at a higher level.</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Example: Calculating </run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15' italic='true'>customer-level averages</run>
              <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'> while showing only region-level charts.</run>
            </formatted-text>
            <top-left>
              <visual-coordinate class='axis'>
                <x-coord cell-offset='0'>
                  <node-reference />
                </x-coord>
                <y-coord cell-offset='0.0789116'>
                  <node-reference />
                </y-coord>
                <page-reference />
              </visual-coordinate>
            </top-left>
            <bottom-right>
              <visual-coordinate class='axis'>
                <x-coord cell-offset='0.998638'>
                  <node-reference />
                </x-coord>
                <y-coord cell-offset='0.998639'>
                  <node-reference />
                </y-coord>
                <page-reference />
              </visual-coordinate>
            </bottom-right>
            <text x='0.5' y='0.5' />
          </annotation>
        </annotations>
      </table>
      <simple-id uuid='{3DACC629-E8AE-4C43-814D-761F2155C73E}' />
    </worksheet>
    <worksheet name='Task 1'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Task 1:</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> Delivery Performance Classification (Calculated Field) 
</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Business Need: </run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>
Operations wants to track delivery efficiency. 
</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Task:</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>
Classify orders as Fast or Delayed. 
</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Condition: </run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>
Delivery ≤ 30 min → Fast 
Else → Delayed</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (Blinkit Orders Dataset)' name='federated.02o7dv11msbzie1gkrdkt08xjj4d' />
          </datasources>
          <datasource-dependencies datasource='federated.02o7dv11msbzie1gkrdkt08xjj4d'>
            <column caption='Delivery Performance' datatype='string' name='[Calculation_1322932443693649920]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Delivery_Time_Min] &lt;= 30 THEN &quot;Fast&quot;&#13;&#10;ELSE &quot;Delayed&quot;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column caption='Delivery Time Min' datatype='integer' name='[Delivery_Time_Min]' role='measure' type='quantitative' />
            <column caption='Order ID' datatype='integer' name='[Order_ID]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1322932443693649920]' derivation='None' name='[none:Calculation_1322932443693649920:nk]' pivot='key' type='nominal' />
            <column-instance column='[Category]' derivation='None' name='[none:Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Order_ID]' derivation='None' name='[none:Order_ID:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <color column='[federated.02o7dv11msbzie1gkrdkt08xjj4d].[none:Category:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.02o7dv11msbzie1gkrdkt08xjj4d].[none:Order_ID:ok]</rows>
        <cols>[federated.02o7dv11msbzie1gkrdkt08xjj4d].[none:Calculation_1322932443693649920:nk]</cols>
      </table>
      <simple-id uuid='{56A8BB89-EEA8-404C-840F-3C8927036E80}' />
    </worksheet>
    <worksheet name='Task 2'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Task 2:</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> Loss-Making Orders Identification 

</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Business Need: </run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>
High sales do not always mean high profit. 
</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Task:</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>
Identify orders resulting in loss.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (Blinkit Orders Dataset)' name='federated.02o7dv11msbzie1gkrdkt08xjj4d' />
          </datasources>
          <datasource-dependencies datasource='federated.02o7dv11msbzie1gkrdkt08xjj4d'>
            <column caption='Loss Orders' datatype='string' name='[Calculation_1322932443695108097]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Profit] &lt; 0 THEN &quot;Loss-Making&quot;&#13;&#10;ELSE &quot;Profitable&quot;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Order ID' datatype='integer' name='[Order_ID]' role='dimension' type='ordinal' />
            <column datatype='real' name='[Profit]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1322932443695108097]' derivation='None' name='[none:Calculation_1322932443695108097:nk]' pivot='key' type='nominal' />
            <column-instance column='[City]' derivation='None' name='[none:City:nk]' pivot='key' type='nominal' />
            <column-instance column='[Order_ID]' derivation='None' name='[none:Order_ID:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Pie' />
            <encodings>
              <color column='[federated.02o7dv11msbzie1gkrdkt08xjj4d].[none:City:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.02o7dv11msbzie1gkrdkt08xjj4d].[none:Order_ID:ok]</rows>
        <cols>[federated.02o7dv11msbzie1gkrdkt08xjj4d].[none:Calculation_1322932443695108097:nk]</cols>
      </table>
      <simple-id uuid='{3DB30A75-380A-44CC-B3A7-857FB649C691}' />
    </worksheet>
    <worksheet name='Task 3'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Task 3:</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> Top N Products Analysis (Parameter) 

</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Business Need:</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> 
The product team wants to focus on top-performing products. 
</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Task:</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> Create a Top N Products dynamic analysis.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (Blinkit Orders Dataset)' name='federated.02o7dv11msbzie1gkrdkt08xjj4d' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Top N Products' datatype='integer' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='9'>
              <calculation class='tableau' formula='9' />
              <range max='50' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.02o7dv11msbzie1gkrdkt08xjj4d'>
            <column caption='Top N Filter' datatype='string' name='[Calculation_1322932443697016834]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF RANK(SUM([Sales])) &lt;= [Parameters].[Parameter 1] THEN &quot;Top&quot;&#13;&#10;ELSE &quot;Others&quot;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Product Name' datatype='string' name='[Product_Name]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Sales]' role='measure' type='quantitative' />
            <column-instance column='[Product_Name]' derivation='None' name='[none:Product_Name:nk]' pivot='key' type='nominal' />
            <column-instance column='[Sales]' derivation='Sum' name='[sum:Sales:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1322932443697016834]' derivation='User' name='[usr:Calculation_1322932443697016834:nk:1]' pivot='key' type='nominal'>
              <table-calc ordering-type='Columns' />
            </column-instance>
          </datasource-dependencies>
          <filter class='categorical' column='[federated.02o7dv11msbzie1gkrdkt08xjj4d].[usr:Calculation_1322932443697016834:nk:1]'>
            <groupfilter function='member' level='[usr:Calculation_1322932443697016834:nk:1]' member='&quot;Top&quot;' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <shelf-sorts>
            <shelf-sort-v2 dimension-to-sort='[federated.02o7dv11msbzie1gkrdkt08xjj4d].[none:Product_Name:nk]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.02o7dv11msbzie1gkrdkt08xjj4d].[sum:Sales:qk]' shelf='rows' />
          </shelf-sorts>
          <slices>
            <column>[federated.02o7dv11msbzie1gkrdkt08xjj4d].[usr:Calculation_1322932443697016834:nk:1]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='legend-title-text'>
            <format attr='color' field='[Parameters].[Parameter 1]' value='Top N Products'>
              <formatted-text>
                <run>Top N Products</run>
              </formatted-text>
            </format>
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <color column='[Parameters].[Parameter 1]' />
              <text column='[federated.02o7dv11msbzie1gkrdkt08xjj4d].[sum:Sales:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.02o7dv11msbzie1gkrdkt08xjj4d].[none:Product_Name:nk]</rows>
        <cols>[federated.02o7dv11msbzie1gkrdkt08xjj4d].[sum:Sales:qk]</cols>
      </table>
      <simple-id uuid='{F2832854-B926-4B4B-8C27-CB8A3409576D}' />
    </worksheet>
    <worksheet name='Task 4'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Task 4: </run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>City-Level Benchmarking (FIXED LOD) 
</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Business Need:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Compare city performance independent of category filters. </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Task:</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> Calculate average sales per city using FIXED LOD.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (Blinkit Orders Dataset)' name='federated.02o7dv11msbzie1gkrdkt08xjj4d' />
          </datasources>
          <datasource-dependencies datasource='federated.02o7dv11msbzie1gkrdkt08xjj4d'>
            <column caption='City Avg Sales (FIXED)' datatype='real' name='[Calculation_1322932443699937283]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [City] : AVG([Sales]) }' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='integer' name='[Sales]' role='measure' type='quantitative' />
            <column-instance column='[Category]' derivation='None' name='[none:Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[City]' derivation='None' name='[none:City:nk]' pivot='key' type='nominal' />
