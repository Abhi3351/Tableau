      <aliases enabled='yes' />
      <column caption='Delivery Performance' datatype='string' name='[Calculation_1322932443693649920]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Delivery_Time_Min] &lt;= 30 THEN &quot;Fast&quot;&#13;&#10;ELSE &quot;Delayed&quot;&#13;&#10;END' />
      </column>
      <column caption='Loss Orders' datatype='string' name='[Calculation_1322932443695108097]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Profit] &lt; 0 THEN &quot;Loss-Making&quot;&#13;&#10;ELSE &quot;Profitable&quot;&#13;&#10;END' />
      </column>
      <column caption='Top N Filter' datatype='string' name='[Calculation_1322932443697016834]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF RANK(SUM([Sales])) &lt;= [Parameters].[Parameter 1] THEN &quot;Top&quot;&#13;&#10;ELSE &quot;Others&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='City Avg Sales (FIXED)' datatype='real' name='[Calculation_1322932443699937283]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [City] : AVG([Sales]) }' />
      </column>
      <column caption='Product-Level Avg Sales (INCLUDE)' datatype='real' name='[Calculation_1322932443701800964]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ INCLUDE [Product_Name] : AVG([Sales]) }' />
      </column>
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column caption='Delivery Time Min' datatype='integer' name='[Delivery_Time_Min]' role='measure' type='quantitative' />
