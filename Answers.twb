    <worksheet name='Task 5'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Task 5:</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> Customer/Product Detail Impact (INCLUDE LOD)

</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Business Need:</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> The sales team wants average sales considering product-level detail, even when product is not shown. 
</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Task:</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> Create a calculation that finds the average sales at the product level, but allows the result to be used at a higher level (such as Category or Region). Use INCLUDE LOD.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (Blinkit Orders Dataset)' name='federated.02o7dv11msbzie1gkrdkt08xjj4d' />
          </datasources>
          <datasource-dependencies datasource='federated.02o7dv11msbzie1gkrdkt08xjj4d'>
            <column caption='Product-Level Avg Sales (INCLUDE)' datatype='real' name='[Calculation_1322932443701800964]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ INCLUDE [Product_Name] : AVG([Sales]) }' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column caption='Product Name' datatype='string' name='[Product_Name]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Sales]' role='measure' type='quantitative' />
            <column-instance column='[Category]' derivation='None' name='[none:Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1322932443701800964]' derivation='Sum' name='[sum:Calculation_1322932443701800964:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Sales]' derivation='Sum' name='[sum:Sales:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
